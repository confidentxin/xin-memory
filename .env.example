OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
MEMORY_API_HOST=127.0.0.1
MEMORY_API_PORT=8741
